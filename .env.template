# Environment Variables Template for Defender for Containers Simulation
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (or set these as system environment variables)
# 2. Replace the placeholder values with your actual AKS cluster details
# 3. Source this file: `. ./.env` (Linux/Mac) or load in PowerShell
#
# To find your cluster details: az aks list --output table

# Your Azure Subscription ID (required)
AZURE_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID

# Your Resource Group name where the AKS cluster is located (required)
AZURE_RESOURCE_GROUP=YOUR_RESOURCE_GROUP

# Your AKS Cluster name (required)
AZURE_CLUSTER_NAME=YOUR_CLUSTER_NAME

# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Auto-cleanup after testing (true/false)
AUTO_CLEANUP=false